// Prisma schema for Nihongo with Nikki

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  password     String?
  image        String?
  provider     String   @default("credentials") // "credentials" or "google"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model UserProgress {
  id        String   @id @default(cuid())
  userId    String
  key       String   // e.g. "kanji", "vocab", "grammar"
  itemId    String
  state     String   @default("new") // "new", "learning", "mastered"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, key, itemId])
}
